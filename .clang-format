---
# Применяем настройки к C++.
Language: Cpp

# Берём стандартный стиль LLVM и переопределяем нужные параметры ниже.
BasedOnStyle: LLVM

# Синтаксис и возможности C++20.
Standard: c++20

# Количество пробелов на один уровень отступа.
IndentWidth: 2

# Ширина табуляции, если она где-либо встретится.
TabWidth: 2

# Никогда не использовать TAB для отступов.
UseTab: Never

# Максимальная рекомендуемая длина строки.
# Если строка длиннее, clang-format постарается перенести её.
ColumnLimit: 80

# ------------------------------------------------------------
# ACCESS MODIFIERS
# ------------------------------------------------------------

# Смещаем public/private/protected на один уровень влево.
AccessModifierOffset: -4

# Не создаём дополнительный уровень отступа после public/private/protected.
IndentAccessModifiers: false


# ------------------------------------------------------------
# NAMESPACES
# ------------------------------------------------------------

# Не добавляем отступ содержимому namespace.
#
# namespace project {
#     // ...
# }
#
# превратится в:
#
# namespace project {
# // ...
# }
NamespaceIndentation: None


# ------------------------------------------------------------
# BRACES
# ------------------------------------------------------------

# Используем собственную конфигурацию расположения фигурных скобок.
BreakBeforeBraces: Custom

# Дополнительные правила для фигурных скобок.
BraceWrapping:

  # Открывающая скобка класса идёт на новой строке.
  #
  # class Foo
  # {
  # };
  AfterClass: false

  # То же самое для enum.
  AfterEnum: false

  # Открывающая скобка функции идёт на новой строке.
  #
  # void foo()
  # {
  # }
  AfterFunction: false

  # Namespace не отделяется дополнительной строкой.
  AfterNamespace: false

  # То же для struct.
  AfterStruct: false

  # То же для union.
  AfterUnion: false

  # catch начинается с новой строки.
  #
  # try
  # {
  # }
  # catch (...)
  # {
  # }
  BeforeCatch: false

  # else начинается с новой строки.
  #
  # if (...)
  # {
  # }
  # else
  # {
  # }
  BeforeElse: false

  # Не увеличиваем отступ для самих фигурных скобок.
  IndentBraces: false


# ------------------------------------------------------------
# SHORT FUNCTIONS / BLOCKS
# ------------------------------------------------------------

# Пустые функции разрешено оставлять в одну строку.
#
# void foo() {}
AllowShortFunctionsOnASingleLine: All

# Короткие блоки не объединяем в одну строку.
AllowShortBlocksOnASingleLine: Always

# Короткие if не объединяем в одну строку.
#
# if (ready) return;
#
# будет:
#
# if (ready)
# {
#     return;
# }
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLambdasOnASingleLine: All

# Короткие циклы также не объединяем в одну строку.
AllowShortLoopsOnASingleLine: true


# ------------------------------------------------------------
# POINTERS / REFERENCES
# ------------------------------------------------------------

# Звёздочка относится к типу.
#
# int* ptr;
#
# вместо:
#
# int *ptr;
PointerAlignment: Left

# Для ссылок используем такое же выравнивание, как для указателей.
ReferenceAlignment: Right

# Не пытаться автоматически определить стиль указателей
# из существующего кода.
DerivePointerAlignment: false


# ------------------------------------------------------------
# SPACES
# ------------------------------------------------------------

# Перед '(' пробел ставится только у управляющих конструкций:
#
# if (x)
# for (auto x : xs)
# while (x)
#
# но:
#
# foo(x)
SpaceBeforeParens: ControlStatements

# Пробелы вокруг операторов присваивания.
#
# x = 10;
# x += 1;
SpaceBeforeAssignmentOperators: true


# ------------------------------------------------------------
# CONSTRUCTORS
# ------------------------------------------------------------

# Инициализаторы конструктора переносятся перед запятой.
#
# Foo::Foo()
#     : a_(1)
#     , b_(2)
# {
# }
BreakConstructorInitializers: BeforeComma

# Стараться группировать инициализаторы конструктора,
# если они помещаются в текущую строку.
PackConstructorInitializers: CurrentLine

# Отступ для списка инициализации конструктора.
ConstructorInitializerIndentWidth: 2


# ------------------------------------------------------------
# ALIGNMENT
# ------------------------------------------------------------

# Выравнивать содержимое после открывающей скобки.
#
# foo(first_argument,
#     second_argument);
AlignAfterOpenBracket: Align

# Стараться выравнивать бинарные операторы.
AlignOperands: Align

# Выравнивать завершающие комментарии.
#
# int foo = 1;  // comment
# int bar = 2;  // comment
AlignTrailingComments: true


# ------------------------------------------------------------
# FUNCTION ARGUMENTS
# ------------------------------------------------------------

# Не пытаться упаковать несколько аргументов функции в одну строку.
#
# foo(first,
#     second,
#     third);
BinPackArguments: true

# Аналогично для параметров объявления функции.
#
# void foo(
#     int first,
#     int second,
#     int third);
BinPackParameters: false


# ------------------------------------------------------------
# BINARY OPERATORS
# ------------------------------------------------------------

# Перенос бинарных операторов оставляет оператор в конце предыдущей строки.
#
# auto result = first +
#               second;
BreakBeforeBinaryOperators: None


# ------------------------------------------------------------
# BRACED INITIALIZERS
# ------------------------------------------------------------

# Использовать современный стиль C++11 для {}.
#
# std::vector<int> values{1, 2, 3};
Cpp11BracedListStyle: true


# ------------------------------------------------------------
# INCLUDES
# ------------------------------------------------------------

# Сортировать include с учётом регистра.
SortIncludes: CaseSensitive

# Разделять группы include.
#
# #include "project/foo.hpp"
#
# #include <algorithm>
# #include <string>
IncludeBlocks: Regroup

# Правила сортировки include.
IncludeCategories:

  # Собственные заголовки проекта получают приоритет 1.
  #
  # #include "project/foo.hpp"
  - Regex: '^"project/'
    Priority: 1
    SortPriority: 1

  # Заголовки вида *.h / *.hpp в <> получают приоритет 2.
  - Regex: '^<.*\.h(pp)?>'
    Priority: 2
    SortPriority: 2

  # Остальные системные заголовки получают приоритет 3.
  - Regex: '^<'
    Priority: 3
    SortPriority: 3

  # Всё остальное получает самый низкий приоритет.
  - Regex: '.*'
    Priority: 4
    SortPriority: 4


# ------------------------------------------------------------
# NAMESPACE COMMENTS
# ------------------------------------------------------------

# Добавлять комментарий в конце большого namespace.
#
# namespace project
# {
#     ...
# } // namespace project
FixNamespaceComments: true


# ------------------------------------------------------------
# COMMENTS
# ------------------------------------------------------------

# Разрешить clang-format переносить текст комментариев.
ReflowComments: true


# ------------------------------------------------------------
# SPACES
# ------------------------------------------------------------

# Не добавлять пробелы внутри < >.
#
# std::vector<int>
#
# вместо:
#
# std::vector< int >
SpacesInAngles: false

# Не добавлять пробелы внутри контейнеров.
#
# {1, 2, 3}
#
# вместо:
#
# { 1, 2, 3 }
SpacesInContainerLiterals: false


# ------------------------------------------------------------
# ACCESS MODIFIERS
# ------------------------------------------------------------

# Пустая строка перед public/private/protected добавляется
# только когда это логически отдельный блок.
EmptyLineBeforeAccessModifier: LogicalBlock

# Максимум одна пустая строка подряд.
MaxEmptyLinesToKeep: 1


# ------------------------------------------------------------
# QUALIFIERS
# ------------------------------------------------------------

# Не менять положение const/volatile автоматически.
#
# Оставляем написание:
#
# const int value;
#
# как оно есть.
QualifierAlignment: Leave


# ------------------------------------------------------------
# C++20 REQUIRES
# ------------------------------------------------------------

# requires-clause помещается на отдельную строку.
RequiresClausePosition: OwnLine

# Управляет отступом выражений requires.
RequiresExpressionIndentation: OuterScope


# ------------------------------------------------------------
# FORMAT PENALTIES
# ------------------------------------------------------------

# "Цена" переноса комментария.
# Чем больше число, тем сильнее clang-format старается
# не переносить комментарий.
PenaltyBreakComment: 300

# "Цена" переноса строкового литерала.
# Большое значение заставляет максимально долго
# сохранять строку целиком.
PenaltyBreakString: 1000

...
